<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The API deploy publishes the whole solution into one folder; the worker ships only as a container (see Dockerfile). -->
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.26.0" />
    <PackageReference Include="Azure.Storage.Queues" Version="12.28.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kinshout.Api.Tests" />
  </ItemGroup>

</Project>
